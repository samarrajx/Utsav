{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["web/js/types.js", "web/js/engine/**/*.js", "api/**/*.js"],
  "exclude": ["node_modules", "tests"]
}
